#---- App settings ----
FP_API_TITLE="Flood risk calculation - OGC API Processes"
FP_API_DESCRIPTION="An OGC API Processes implementation for noise calculations."

FP_RESULT_CACHE_HOST="redis"
FP_RESULT_CACHE_PORT=6379
FP_RESULT_CACHE_DB=1

FP_CELERY_BROKER_HOST="redis"
FP_CELERY_BROKER_PORT=6379
FP_CELERY_BROKER_DB=0
FP_CELERY_RESULTS_TTL_DAYS=7
FP_CELERY_TASK_TLIMIT_HARD=1800
FP_CELERY_TASK_TLIMIT_SOFT=1500
FP_CELERY_JOB_MODE=False
FP_CELERY_QUEUE=celery
FP_RESULTS_TEMP_TTL_HOURS=24

FP_JOB_STATUS_TTL_DAYS=7
FP_SYNC_EXECUTION_TIMEOUT_SECONDS=10

FP_SKIP_INPUT_VALIDATION="false"
FP_LOG_LEVEL="DEBUG"

PFR_ALLOWED_INPUT_ORIGINS=http://localhost:8000
PFR_REFERENCE_HREF=https://...
PFR_DROP_INVALID_INPUT_FEATURES=true
PFR_CITYWIDE_CHUNK_SIZE=10
PFR_OGC_PAGE_LIMIT=2000
PFR_DEV_CACHE_DIR=/tmp/pfr
PFR_PROCESS_DESCRIPTION_PFR_FILE=process-descriptions/pfr.yaml
PFR_PROCESS_DESCRIPTION_PFR_CITYWIDE_FILE=process-descriptions/pfr-citywide.yaml
#---- Dev environment settings ----
REDIS_PORT=6731
DOCKER_DEV_NETWORK=dev

#---- Docker build settings ----
# Do not modify unless you know what you are doing!
CONTAINER_REGISTRY=myregistry.io
IMAGE_NAME=models/pluvial-flood-risk
IMAGE_TAG=0.2.0